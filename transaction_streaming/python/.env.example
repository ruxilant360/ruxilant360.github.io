# Copy this file to .env (same folder) and fill in. .env is ignored by git.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Local PostgreSQL that the app loads the sample into and queries
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
# Optional: a different Groq model (openai/gpt-oss-20b is the default; qwen/qwen3.8-27b or openai/gpt-oss-120b also work)
# GROQ_MODEL=openai/gpt-oss-20b
